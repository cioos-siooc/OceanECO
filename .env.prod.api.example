# API machine — copy to .env.prod.api, then:
#   docker compose -f docker-compose.prod.api.yml --env-file .env.prod.api up -d
# Runs api, db-ch (receives the PROCESS machine's synced data), tunnel,
# sensors-scheduler and backup-scheduler.

API_PORT=9011

# Cloudflare Tunnel connector token (Zero Trust → Networks → Tunnels → <tunnel>
# → Install connector; the string after `--token`). Public hostname → http://api:4000.
CLOUDFLARE_TUNNEL_TOKEN=

# --- ClickHouse (api -> db-ch). CH_PASSWORD must equal CLICKHOUSE_PASSWORD,
# which seeds db-ch's password on first boot.
CH_HOST=db-ch
CH_PORT=8123
CH_USER=default
CH_PASSWORD=
CLICKHOUSE_PASSWORD=

# Set CH_USE_REMOTE=true + CH_REMOTE_* to use a managed ClickHouse instead of db-ch
CH_USE_REMOTE=false
CH_REMOTE_URL=
CH_REMOTE_USER=
CH_REMOTE_PASSWORD=

# --- Host paths ---
CH_DATA_DIR=/path/to/clickhouse_data
DATA_DIR=/path/to/data                # bind-mounted to /opt/data
SSC_IMAGE_DIR=/opt/data/images/SSC
VECTOR_ROOT=/opt/data/bathymetry/west_coast_DEM/vect

# --- SSC sync from the PROCESS machine ---
SSC_SYNC_STAGING_DIR=/opt/data/SalishSeaCast/sync_staging
# Must be identical to SYNC_API_TOKEN in .env.process.remote
SYNC_API_TOKEN=

# --- Prefect (shared server) ---
PREFECT_API_URL=https://pipelines.cioospacific.ca/api
PREFECT_API_AUTH_STRING=              # user:password

# --- Sensors ---
ONC_TOKEN=
# ERDDAP_CRON=0 * * * *
# ONC_CRON=30 * * * *
# SENSORS_SCHEDULE_PAUSED=false

# --- Nightly backup (scripts/backup.sh via backup-scheduler) ---
BACKUP_DEST=user@backup-host:/path/to/backup
BACKUP_SSH=ssh -p 22 -i /home/user/.ssh/id_ed25519
BACKUP_SSH_DIR=/home/user/.ssh        # host dir holding the backup key
# BACKUP_CRON=0 3 * * *
# BACKUP_SCHEDULE_PAUSED=false
