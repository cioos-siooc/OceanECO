# Dev stack — copy to .env.dev, then:
#   docker compose -f docker-compose.dev.yml --env-file .env.dev up

FRONTEND_TARGET=development
FRONTEND_COMMAND=npm run dev
FRONT_PORT=9010
API_PORT=9011

NUXT_PUBLIC_MAPBOX_TOKEN=
NUXT_PUBLIC_API_BASE_URL=http://localhost:9011
NUXT_PUBLIC_VERSION=1.0

# Data paths — SSC model (in-container)
SSC_NC_DIR=/opt/data/SalishSeaCast/nc
SSC_IMAGE_DIR=/opt/data/SalishSeaCast/images

# Local db-ch password (leave empty for none)
CLICKHOUSE_PASSWORD=

# Set CH_USE_REMOTE=true to point the API at a remote ClickHouse instead of db-ch
CH_USE_REMOTE=false
CH_REMOTE_URL=
CH_REMOTE_USER=default
CH_REMOTE_PASSWORD=

SYNC_API_TOKEN=

# Umami (usage analytics, shared CIOOS Pacific server) — leave empty to disable
NUXT_PUBLIC_UMAMI_WEBSITE_ID=
NUXT_PUBLIC_UMAMI_HOST=https://analytics.cioospacific.ca

# db-ch data dirs on the host (default ./clickhouse/{data,logs})
CH_DATA_DIR=./clickhouse/data
CH_LOGS_DIR=./clickhouse/logs
