# PROCESS machine — copy to .env.process.remote, then:
#   docker compose -f docker-compose.prod.process.yml --env-file .env.process.remote --profile tools up -d
# Ad-hoc CLI: ... exec scheduler uv run python -m SSC.cli <step>
#
# Also required (files, not env vars):
#   ./secrets/id_OceanECO   — private key, API_SSH_KEY_PATH
#   ./secrets/known_hosts   — API_SSH_KNOWN_HOSTS

# --- Local ClickHouse (status tracking). CH_PASSWORD must equal CLICKHOUSE_PASSWORD.
CH_HOST=localhost
CH_PORT=8123
CH_USER=default
CH_PASSWORD=
CLICKHOUSE_PASSWORD=

# --- ERDDAP source — defaults are correct, uncomment only to override ---
# ERDDAP_BASE=https://salishsea.eos.ubc.ca/erddap
# ERDDAP_DATASET_CHEMISTRY=ubcSSg3DChemistryFields1hV21-11
# ERDDAP_DATASET_PHYSICS=ubcSSg3DPhysicsFields1hV21-11

# --- Local output dirs (./data -> /opt/data) ---
SSC_NC_DIR=/opt/data/SSC/nc
SSC_IMAGE_DIR=/opt/data/images/SSC
# Must stay under /opt/data: sync.py derives the API-side path relative to it
SSC_SYNC_STAGING_DIR=/opt/data/SalishSeaCast/sync_staging
GRID_CACHE_PATH=/opt/data/cache/oa_grid_cache.npz

# --- Cloudflare Access service token (used by every cloudflared call) ---
CF_TOKEN_ID=
CF_TOKEN_SECRET=

# --- SSH/rsync to the API machine via `cloudflared access ssh` ---
API_SSH_HOST=ssh.example.org          # Cloudflare Access hostname
API_SSH_USER=
API_SSH_KEY_PATH=/run/secrets/id_OceanECO
API_SSH_KNOWN_HOSTS=/run/secrets/known_hosts

# --- API machine ---
# Host path backing the API machine's /opt/data bind mount (not the in-container path)
SYNC_API_DATA_DIR=/path/to/data
# The API as seen from the API host (curl runs there over SSH)
SYNC_API_BASE_URL=http://127.0.0.1:9011   # API_PORT in .env.prod.api
# Must be identical to SYNC_API_TOKEN in .env.prod.api
SYNC_API_TOKEN=

# --- Prefect (shared server) ---
PREFECT_API_URL=https://pipelines.cioospacific.ca/api
PREFECT_API_AUTH_STRING=              # user:password
# RUN_CRON=0 */3 * * *
# RUN_LIMIT=10
# RUN_WORKERS=30
# RUN_SCHEDULE_PAUSED=false
